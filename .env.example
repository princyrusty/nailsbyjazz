# Local development settings. On Render these are set in the dashboard (Environment tab).
PORT=3000
NODE_ENV=development

# Admin panel login (/admin)
ADMIN_USERNAME=nailsbyjazzy
ADMIN_PASSWORD=change-me

# Long random text used to sign login cookies
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string (Render sets this automatically from the Blueprint).
# Leave empty locally to use JSON files in data/store. MONGODB_URI also works instead.
DATABASE_URL=

# First-run defaults (can be changed later in Admin → Settings)
WHATSAPP_NUMBER=918439411560
INSTAGRAM=jassmakeover13

# Online payments (later): set PAYMENT_MODE=razorpay and add keys from dashboard.razorpay.com
PAYMENT_MODE=whatsapp
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
